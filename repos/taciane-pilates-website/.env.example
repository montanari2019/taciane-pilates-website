# Copie para .env.local e ajuste. Tudo é opcional: os padrões ficam em src/Environment.ts.
# Só variáveis NEXT_PUBLIC_* chegam ao navegador e são lidas apenas por src/Environment.ts.

# Endereço base do site (troque pelo domínio de produção quando existir)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

